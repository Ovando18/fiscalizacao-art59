# Modelo dos Secrets do Streamlit Cloud (App settings › Secrets).
# Localmente, copie para .streamlit/secrets.toml (arquivo ignorado pelo Git).

# Banco PostgreSQL do Supabase – string do "Session pooler" (Connect › Session pooler)
DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Supabase Storage (evidências) – chave SECRETA, nunca a publishable/anon
SUPABASE_URL = "https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_KEY = "sb_secret_..."
SUPABASE_BUCKET = "evidencias"

# SMTP do Zimbra
SMTP_HOST = "mail.seudominio.org.br"
SMTP_PORT = "587"
SMTP_USER = "fiscalizacao@creams.org.br"
SMTP_PASSWORD = ""
SMTP_FROM_NAME = "Crea-MS – Departamento de Fiscalização"
