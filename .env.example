# Copie para .env e preencha. NUNCA versione o arquivo .env.
SMTP_HOST=mail.seudominio.org.br
SMTP_PORT=587
SMTP_USER=fiscalizacao@creams.org.br
SMTP_PASSWORD=
SMTP_FROM_NAME=Crea-MS – Departamento de Fiscalização

# --- Supabase (opcional; sem estas variáveis o sistema usa SQLite + pasta evidencias/) ---
# Banco: use a string do "Session pooler" (compatível com IPv4)
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Evidências (Storage): URL do projeto e chave SECRETA (sb_secret_... ou service_role legada)
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=evidencias
